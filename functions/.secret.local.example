# Copy this file to functions/.secret.local (gitignored) so the emulator can boot the
# advanceAiTurn callable, which is bound to the ANTHROPIC_API_KEY secret.
#
# For local/emulator smoke tests (tests/ai_functions_smoke.sh), a dummy value is enough:
# the "night" and "vote" phases exercised by that test never call generateSpeech() /
# the Anthropic API. Only the "day" phase (AI chat) actually sends this key to Anthropic.
#
# NEVER put a real key in this .example file, and never commit functions/.secret.local.
# For production, register the real key with:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=emulator-dummy-not-a-real-key
